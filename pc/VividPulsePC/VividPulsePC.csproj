<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vivid Pulse PC: a small Windows program (needs nothing installed: .NET Framework 4.7.2+ comes with Windows 10 and 11). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VividPulsePC</AssemblyName>
    <RootNamespace>VividPulsePC</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 2.N: N is how many times the PC program has changed (CI passes it; a build at home is 2.0). -->
    <Version>2.0.0</Version>
    <Product>Vivid Pulse PC</Product>
    <AssemblyTitle>Vivid Pulse PC</AssemblyTitle>
    <Company>Jambo199</Company>
    <Description>Lets Vivid Pulse on your phone see this PC</Description>
    <DebugType>none</DebugType>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression" />
    <EmbeddedResource Include="icon.ico" LogicalName="icon.ico" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
